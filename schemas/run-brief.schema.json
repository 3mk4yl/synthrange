{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthrange.dev/schemas/run-brief.schema.json",
  "title": "SynthRange Run Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "synthrange/v1alpha1"},
    "kind": {"const": "RunBrief"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "objective"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"},
        "name": {"type": "string", "minLength": 3},
        "objective": {"type": "string", "minLength": 10}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "playbooks", "participants", "trafficPolicy", "authority", "lifecycle", "evidence", "approvals"],
      "properties": {
        "target": {
          "type": "object", "additionalProperties": false,
          "required": ["adapterId", "endpoint"],
          "properties": {
            "adapterId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "endpoint": {"type": "string", "format": "uri"}
          }
        },
        "playbooks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "participants": {
          "type": "object", "additionalProperties": false, "required": ["red", "blue"],
          "properties": {"red": {"$ref": "#/$defs/participant"}, "blue": {"$ref": "#/$defs/participant"}}
        },
        "trafficPolicy": {
          "type": "object", "additionalProperties": false,
          "required": ["proxyRequired", "allowedMethods", "maxRequests", "sustainedRequestsPerSecond", "burst"],
          "properties": {
            "proxyRequired": {"const": true},
            "allowedMethods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET", "HEAD", "OPTIONS", "POST", "PUT", "PATCH", "DELETE"]}},
            "maxRequests": {"type": "integer", "minimum": 1, "maximum": 10000},
            "sustainedRequestsPerSecond": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
            "burst": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "authority": {
          "type": "object", "additionalProperties": false, "required": ["red", "blue"],
          "properties": {"red": {"$ref": "#/$defs/authority"}, "blue": {"$ref": "#/$defs/authority"}}
        },
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "required": ["maxDurationSeconds", "baselineSeconds", "stopConditions", "requiredRunStates"],
          "properties": {
            "maxDurationSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
            "baselineSeconds": {"type": "integer", "minimum": 0, "maximum": 3600},
            "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
            "requiredRunStates": {"type": "array", "const": ["created", "preflight", "baseline", "active", "finalizing", "stopped", "collected", "sealed"]}
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false, "required": ["requiredArtifacts", "observerAuthoritative"],
          "properties": {
            "requiredArtifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$"}},
            "observerAuthoritative": {"const": true}
          }
        },
        "approvals": {
          "type": "object", "additionalProperties": false, "required": ["recordingRequired", "defaultDecision"],
          "properties": {"recordingRequired": {"const": true}, "defaultDecision": {"enum": ["deny", "pause"]}}
        }
      }
    }
  },
  "$defs": {
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["integration", "provider", "model", "requiredOutputs"],
      "properties": {
        "integration": {"type": "string", "minLength": 2},
        "provider": {"type": "string", "minLength": 2},
        "model": {"type": "string", "minLength": 2},
        "requiredOutputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[a-z0-9][a-z0-9._/-]*$"}}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["autonomous", "approvalRequired", "prohibited"],
      "properties": {
        "autonomous": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "approvalRequired": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "prohibited": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}}
      }
    }
  }
}
