{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthrange.dev/schemas/target-adapter.schema.json",
  "title": "SynthRange Target Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "synthrange/v1alpha1"
    },
    "kind": {
      "const": "TargetAdapter"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "deployment",
        "capabilities",
        "endpoints",
        "telemetry",
        "lifecycle"
      ],
      "properties": {
        "platform": {
          "enum": [
            "web-application",
            "linux",
            "windows",
            "macos"
          ]
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "entrypoint"
          ],
          "properties": {
            "type": {
              "enum": [
                "compose",
                "container",
                "virtual-machine",
                "physical-host",
                "manual"
              ]
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "telemetry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/telemetry"
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "tools": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "available",
            "prototype",
            "planned"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "port",
        "exposure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "protocol": {
          "enum": [
            "http",
            "https",
            "ssh",
            "winrm",
            "other"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string"
        },
        "exposure": {
          "enum": [
            "adversarial",
            "defender",
            "observer",
            "management"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "enum": [
            "application-log",
            "container-log",
            "system-log",
            "network",
            "health",
            "other"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "verify",
        "reset",
        "stop"
      ],
      "properties": {
        "start": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reset": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stop": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
