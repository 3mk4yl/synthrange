PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=8080
LOG_PATH=/srv/synthrange-traffic-proxy/logs/proxy-events.jsonl
RUN_ID=prep
# Set RUN_ID to the exact active run before Red starts; mismatched headers are blocked.
# Required: comma-separated approved target names or IP addresses.
TARGET_ALLOW_HOSTS=target.example
TARGET_ALLOW_PORTS=3000,80,443
# Optional: used only to classify known Red source addresses in evidence.
RED_SOURCE_IPS=
# Mechanical run controls. Keep these aligned with the approved run brief.
REQUIRE_RUN_ID=true
ALLOWED_METHODS=GET,HEAD,OPTIONS
MAX_REQUESTS_PER_RUN=60
RATE_LIMIT_REQUESTS_PER_SECOND=1
RATE_LIMIT_BURST=2
