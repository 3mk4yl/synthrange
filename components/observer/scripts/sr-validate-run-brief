#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from pathlib import Path

import jsonschema
import yaml


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: sr-validate-run-brief BRIEF SCHEMA", file=sys.stderr)
        return 2
    brief_path, schema_path = map(Path, sys.argv[1:3])
    try:
        brief = yaml.safe_load(brief_path.read_text(encoding="utf-8"))
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
        jsonschema.Draft202012Validator.check_schema(schema)
        jsonschema.Draft202012Validator(schema).validate(brief)
    except (OSError, ValueError, yaml.YAMLError, jsonschema.ValidationError, jsonschema.SchemaError) as error:
        print(f"run brief validation failed: {error}", file=sys.stderr)
        return 1
    print(brief_path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
