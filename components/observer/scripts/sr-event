#!/usr/bin/env python3
import json, socket, sys
from datetime import datetime, timezone
from pathlib import Path
if len(sys.argv) < 3:
    print("usage: sr-event RUN_DIR EVENT_TYPE [DETAIL] [--key=value ...]", file=sys.stderr); raise SystemExit(2)
run_dir = Path(sys.argv[1]).resolve(); event_type = sys.argv[2]; detail = ""; fields = {}
state_path = run_dir / "state/run-state.json"
if state_path.exists():
    state = json.loads(state_path.read_text(encoding="utf-8"))
    if state.get("status", {}).get("evidenceSealed"):
        print("sealed run is immutable", file=sys.stderr); raise SystemExit(1)
for arg in sys.argv[3:]:
    if arg.startswith('--') and '=' in arg:
        k,v = arg[2:].split('=',1); fields[k]=v
    elif not detail: detail = arg
    else: detail += ' ' + arg
obj = {"time_utc": datetime.now(timezone.utc).isoformat(), "type": event_type, "detail": detail, "observer": socket.gethostname()}
obj.update(fields)
path = run_dir / "timeline.jsonl"; path.parent.mkdir(parents=True, exist_ok=True)
with path.open('a') as f: f.write(json.dumps(obj, sort_keys=True) + "\n")
print(json.dumps(obj, sort_keys=True))
