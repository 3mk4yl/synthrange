# Copy to /srv/synthrange/config/hosts.env and adapt to your environment.
RED_HOST=synthrange@red.example
BLUE_HOST=synthrange@blue.example
TARGET_HOST=synthrange@target.example
PROXY_HOST=synthrange@proxy.example
# PROXY_HOST must provide /srv/synthrange-traffic-proxy/scripts/sr-proxy-export-run.
# Observer passes the validated run ID and exact SINCE/UNTIL window to that command.
OBSERVER_HOST=synthrange@observer.example
TARGET_URL=http://target.example:3000
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new"
CAPTURE_INTERFACE=any
# Required before packet capture. Keep this scoped to explicit range hosts.
CAPTURE_FILTER="host 192.0.2.10 or host 192.0.2.20 or host 192.0.2.30"
CAPTURE_ROTATE_SECONDS=300
CAPTURE_ROTATE_FILES=24
